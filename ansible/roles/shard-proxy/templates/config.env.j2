# shard-proxy environment configuration
# Managed by Ansible — do not edit manually

LISTEN_ADDR={{ listen_addr }}
UDP_LISTEN_PORT={{ udp_listen_port }}
TCP_LISTEN_PORT={{ tcp_listen_port }}
SUBTREE_LISTEN_PORT={{ subtree_listen_port | default(0) }}
BLOCK_LISTEN_PORT={{ block_listen_port | default(0) }}
BEEF_LISTEN_PORT={{ beef_listen_port | default(0) }}
BEEF_SHARD_BITS={{ beef_shard_bits | default(4) }}
BEEF_MAX_OBJECT_BYTES={{ beef_max_object_bytes | default(1048576) }}
REQUIRE_BLOCK_POW={{ 'true' if require_block_pow | default(true) else 'false' }}
MIN_POW_BITS={{ min_pow_bits | default('0') }}
EGRESS_PORT={{ egress_port }}
EGRESS_HOPLIMIT={{ proxy_egress_hoplimit | default(1) }}
EGRESS_MULTICAST_LOOP={{ 'true' if egress_multicast_loop | default(false) else 'false' }}
MULTICAST_IF={{ egress_iface if egress_iface is string else egress_iface | join(',') }}
SHARD_BITS={{ shard_bits }}
MC_SCOPE={{ mc_scope }}
MC_GROUP_ID={{ mc_group_id }}
SOURCE_MODE={{ source_mode | default('asm') }}
{% if bind_source | default('') %}
BIND_SOURCE={{ bind_source }}
{% endif %}
STAMP_SOURCE={{ 'true' if stamp_source | default(true) else 'false' }}
NUM_WORKERS={{ num_workers }}
BSP_RECV_BATCH={{ recv_batch | default(32) }}
METRICS_ADDR={{ metrics_addr }}
OTLP_ENDPOINT={{ otlp_endpoint }}
OTLP_INTERVAL={{ otlp_interval }}
LOG_FORMAT={{ log_format }}
LOG_LEVEL={{ log_level }}
TRACE_SAMPLING={{ trace_sampling }}
DRAIN_TIMEOUT={{ drain_timeout }}
DEBUG={{ 'true' if proxy_debug else 'false' }}
FRAG_MTU={{ frag_mtu | default(0) }}
COALESCE={{ 'true' if coalesce | default(false) else 'false' }}
COALESCE_MAX_BYTES={{ coalesce_max_bytes | default(1500) }}
COALESCE_MAX_MEMBERS={{ coalesce_max_members | default(0) }}
COALESCE_CARRY_TXID={{ 'true' if coalesce_carry_txid | default(false) else 'false' }}
TXID_DEDUP_LOCAL_CAP={{ txid_dedup_local_cap | default(1048576) }}
{% if txid_dedup_backend | default('') %}
TXID_DEDUP_BACKEND={{ txid_dedup_backend }}
{% endif %}
TXID_DEDUP_REDIS_ADDR={{ txid_dedup_redis_addr | default('') }}
{% if txid_dedup_aerospike_hosts | default('') %}
TXID_DEDUP_AEROSPIKE_HOSTS={{ txid_dedup_aerospike_hosts }}
TXID_DEDUP_AEROSPIKE_NAMESPACE={{ txid_dedup_aerospike_namespace | default('cache') }}
TXID_DEDUP_AEROSPIKE_SET={{ txid_dedup_aerospike_set | default('bsp') }}
{% endif %}
TXID_DEDUP_PREFIX={{ txid_dedup_prefix | default('bsp:tx:') }}
TXID_DEDUP_TTL={{ txid_dedup_ttl | default('10m') }}
